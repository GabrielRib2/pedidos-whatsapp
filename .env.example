# Copie este arquivo para ".env" e ajuste.

# Nome da impressora (deixe vazio para usar a impressora PADRAO do sistema).
# Windows: nome exato em "Impressoras e scanners".
# Linux/macOS: rode `lpstat -p` para listar.
IMPRESSORA=

# Tamanho do papel: A4 | A5 | 80mm (bobina termica)
PAPEL=A4

# Numero de copias impressas por pedido
COPIAS=1

# Fuso horario usado nos horarios do pedido
FUSO=America/Sao_Paulo

# Se "false", gera o PDF em ./comandas mas NAO envia para a impressora (bom para testes)
IMPRIMIR=true
